@startuml sequenza-produzione
skinparam dpi 300
skinparam shadowing false
skinparam defaultFontSize 20
skinparam sequenceMessageAlign left
skinparam ArrowColor #444444
skinparam ParticipantBorderColor #444444
skinparam ParticipantBackgroundColor #F5F5F5
skinparam SequenceLifeLineBorderColor #888888
hide footbox

participant "consumatore" as C
participant "summary" as S
participant "store" as ST
participant "tenant" as T
participant "kpi" as K
participant "Cube" as CUBE
participant "modello" as LLM

C -> C: valida il messaggio
C -> S: produci il riepilogo

S -> ST: cerca il riepilogo
alt il riepilogo esiste già
  ST --> S: il riepilogo
  S --> C: il riepilogo, senza chiamare il modello
else non esiste
  ST --> S: nessun riepilogo

  S -> T: leggi lingua e fuso
  T --> S: lingua, fuso

  S -> K: recupera i dati
  K -> K: legge le query configurate
  loop una goroutine per query
    K -> CUBE: interroga
    CUBE --> K: valori
  end
  K --> S: dati e istruzioni

  S -> S: compone il payload
  S -> LLM: genera il testo
  LLM --> S: il testo

  S -> ST: salva il riepilogo
  S --> C: il riepilogo
end

@enduml
